# ==========================================================
# BACKEND ENVIRONMENT VARIABLES
# ==========================================================
PORT=3000
NODE_ENV=development

# MongoDB Atlas Connection URI
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/aethelgard_ecommerce?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=replace_with_a_cryptographically_secure_64_char_hex_secret
JWT_EXPIRES_IN=7d

# Application URLs (Used for CORS, Redirects, and Webhooks)
CLIENT_URL=http://localhost:3000
SERVER_URL=http://localhost:3000

# Cloudinary Media Storage Configuration
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Payment Gateway Sandbox / Test Credentials
PAYMENT_PROVIDER_KEY=pk_test_sandbox_provider_key
PAYMENT_PROVIDER_SECRET=sk_test_sandbox_provider_secret
PAYMENT_WEBHOOK_SECRET=whsec_test_sandbox_webhook_secret

# SMTP / Transactional Email Configuration (OTP & Password Reset)
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=notifications@aethelgard.example.com
EMAIL_PASSWORD=your_smtp_password

# ==========================================================
# FRONTEND ENVIRONMENT VARIABLES
# ==========================================================
VITE_API_BASE_URL=/api
